@model IEnumerable<HW3Admin.Models.PRODUCTS>

@{
    ViewData["Title"] = "Admin";
}

<h1>Admin</h1>

<p>
    <a class="btn btn-success" asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descrition)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImagesPD)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @item.Descrition
                </td>
                <td>
                    ฿@item.Price.ToString("N2")
                </td>
                <td>
                    <img src="~/images/@item.ImagesPD" alt="@item.Name" width="250" height="250" style="object-fit:cover" />
                </td>
                <td>
                    <div class="btn-group-vertical">
                        <a class="btn btn-outline-success" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-outline-success" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a class="btn btn-outline-success" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
